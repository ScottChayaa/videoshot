<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 第二步長按跳播的 15 ms 回饋（規格第五節）。一般權限，不需要執行期詢問 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 剪輯選素材（規格第十九節）；不用系統挑選器，因為它給的 URI 不能刪除 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- 剪輯選素材（規格第十九節）；不用系統挑選器，因為它給的 URI 不能刪除 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 剪輯選素材（規格第十九節）；不用系統挑選器，因為它給的 URI 不能刪除 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 剪輯選素材（規格第十九節）；不用系統挑選器，因為它給的 URI 不能刪除 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- 剪輯輸出（規格第十九節）：背景輸出用前景服務，通知欄顯示進度與結果。Android 15 起類型是 mediaProcessing，14 以下是 dataSync -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application
        android:name=".VideoshotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Videoshot">
        <!--
            鎖直立（規格第六節）：只有橫的影片全螢幕時由 FullscreenSystemEffect 改成橫向。
            configChanges：進出全螢幕轉向時不重建 Activity——重建會銷毀播放器的 WebView，影片從頭重載。
            keyboard／navigation：接上或拔掉實體鍵盤也是設定變更，不列的話 Activity 會重建，
            WebView 重載、全螢幕狀態丟失。
            Android 16 以上的大螢幕系統會忽略 screenOrientation，一律跟著裝置轉。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Videoshot"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            關掉 WorkManager 的自動初始化(androidx.startup)。VideoshotApp 實作了
            Configuration.Provider——若不關掉,WorkManager 的預設初始化 Provider 會在
            attachInfo()/onCreate() 階段(比 Application.onCreate() 更早)就去讀
            workManagerConfiguration,那時候 container 這個 lateinit var 還沒賦值,
            會直接丟 UninitializedPropertyAccessException 讓每次啟動都當機。
            關掉之後改成「用到才初始化」——VideoshotApp.onCreate() 呼叫的
            scheduleDailyBackup() 會是第一個真正碰 WorkManager 的地方,那時候
            container 早就賦值好了。見官方文件「On-demand initialization」那一節。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManager 的前景服務要宣告類型，`setForeground` 才能指定 dataSync／mediaProcessing -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />
    </application>

</manifest>