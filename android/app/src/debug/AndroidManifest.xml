<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 一次性實驗（spike/stage20-bg-export，不合併）：背景導出 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- 開發測試版專用：元件總覽頁（計畫 15A Task 8）。exported 才能用 adb am start 開；
             桌面另有一個「元件總覽」圖示。taskAffinity 跟主程式分開，點圖示才不會只把照片頁叫回前景 -->
        <activity
            android:name=".debug.ComponentCatalogActivity"
            android:exported="true"
            android:label="元件總覽"
            android:taskAffinity="com.xenyaa.videoshot.catalog"
            android:theme="@style/Theme.Videoshot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 開發測試版專用：匯入原型假資料（計畫 15A Task 10），會取代現有圖庫。
             要求 DUMP 權限：只有 adb shell（以及系統）持有，裝置上其他 app 不能觸發。
             adb shell am broadcast -a com.xenyaa.videoshot.debug.SEED -n com.xenyaa.videoshot/.debug.seed.SeedReceiver -->
        <receiver
            android:name=".debug.seed.SeedReceiver"
            android:permission="android.permission.DUMP"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xenyaa.videoshot.debug.SEED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.spike.SpikeExportReceiver"
            android:permission="android.permission.DUMP"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xenyaa.videoshot.debug.SPIKE_EXPORT" />
                <action android:name="com.xenyaa.videoshot.debug.SPIKE_CANCEL" />
            </intent-filter>
        </receiver>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
